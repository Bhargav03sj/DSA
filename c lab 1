#include <stdio.h>
#define SIZE 100

int tree[SIZE];

// Initialize tree
void init() {
    for (int i = 0; i < SIZE; i++) {
        tree[i] = -1;
    }
}

// Insert value at index
void insert(int value, int index) {
    if (index >= SIZE) {
        printf("Index out of range!\n");
        return;
    }

    if (tree[index] == -1) {
        tree[index] = value;
        printf("Inserted %d at index %d\n", value, index);
    } else {
        printf("Position already occupied!\n");
    }
}

// Delete a node
void deleteNode(int index) {
    if (index >= SIZE || tree[index] == -1) {
        printf("No node to delete!\n");
        return;
    }

    tree[index] = -1;
    printf("Node at index %d deleted\n", index);
}

// Display tree (array form)
void display() {
    printf("Tree elements:\n");
    for (int i = 0; i < SIZE; i++) {
        if (tree[i] != -1) {
            printf("Index %d: %d\n", i, tree[i]);
        }
    }
}

int main() {
    int choice, value, index;

    init();

    while (1) {
        printf("\n--- Binary Tree Menu ---\n");
        printf("1. Insert\n");
        printf("2. Delete\n");
        printf("3. Display\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("Enter value to insert: ");
                scanf("%d", &value);
                printf("Enter index: ");
                scanf("%d", &index);
                insert(value, index);
                break;

            case 2:
                printf("Enter index to delete: ");
                scanf("%d", &index);
                deleteNode(index);
                break;

            case 3:
                display();
                break;

            case 4:
                printf("Exiting...\n");
                return 0;

            default:
                printf("Invalid choice!\n");
        }
    }

    return 0;
}
