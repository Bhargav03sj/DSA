#include<stdio.h>
#include<string.h>
int main(){
    char str[100];
    printf("enter expression: ");
    gets(str);
    int len = strlen(str),top=-1,flag=0;
    char stack[len];
    for(int i=0;i<len;i++){
        char ch = str[i];
        if(ch=='('||ch=='['|| ch=='{')
          stack[++top] = ch;
        else if(ch==')'||ch==']'||ch=='}'){
           if(ch== ')'&& stack[top]=='(')
             top--;
           else if(ch == ']' && stack[top]=='[')
              top--;
           else if(ch == '}'&& stack[top]=='{')
              top--;
        
        else{
           flag = 1;
           break;

        }
    }

    }
    if(flag == 0&&top==-1)
       printf("balanced!!");
    else
       printf("unbalanced!!");
    return 0;
}
